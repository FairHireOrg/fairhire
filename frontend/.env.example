# Copy to `frontend/.env`. `.env` is gitignored; never commit it.

# Base URL of the FairHire API. Inlined into the client bundle at build time,
# so rebuild after changing it. Leave unset on Vercel: requests go to the same
# origin's /api, which vercel.json routes to the backend service.
# For local dev, point it at a backend, e.g. http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
