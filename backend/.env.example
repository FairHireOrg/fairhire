# Optional DeepSeek-assisted extraction (hybrid mode).
# Set FAIRHIRE_DEEPSEEK_KEY to enable it; without it the system runs purely
# deterministic (curated ontology + regex, no LLM).
#
# Copy to `backend/.env` and fill in your key. `.env` is gitignored.
FAIRHIRE_DEEPSEEK_URL=https://api.deepseek.com
FAIRHIRE_DEEPSEEK_KEY=sk-your-deepseek-key
FAIRHIRE_DEEPSEEK_MODEL=deepseek-chat
