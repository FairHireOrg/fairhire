# FairHire API. Build:  podman build -t fairhire-api .
#              Run:    podman run --rm -p 8000:8000 --env-file .env fairhire-api
FROM python:3.12-slim

# pdftotext (poppler) extracts text from uploaded PDFs.
RUN apt-get update \
 && apt-get install -y --no-install-recommends poppler-utils \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.18 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" NLTK_DATA=/usr/share/nltk_data PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencies first, so code edits don't reinstall them.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-install-project --no-dev

# The stopword corpus is otherwise downloaded on the first request.
RUN python -m nltk.downloader -d "$NLTK_DATA" stopwords

COPY api.py ./
COPY fairhire ./fairhire

RUN useradd --system --uid 10001 app
USER app

EXPOSE 8000
# Vercel routes to $PORT; default to 8000 for local podman runs.
CMD ["sh", "-c", "exec uvicorn api:app --host 0.0.0.0 --port ${PORT:-8000}"]
